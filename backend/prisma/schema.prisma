// Modelo de datos aprobado en docs/specs.md v1.1 (seccion 5) y architecture/er_diagram.md
// Stack confirmado: SQLite + Prisma (Decision PO/PM, P13)

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NOTA TECNICA: el conector SQLite de Prisma no soporta `enum` nativo.
// Se modelan como String con los valores permitidos documentados aqui;
// la validacion de valores se hace en la capa de aplicacion.
// User.rol: "ADMIN" | "USUARIO"
// Ticket.estado: "POR_HACER" | "EN_PROGRESO" | "REVIEW" | "TERMINADO" (orden pendiente de confirmar, R-07)
// Ticket.prioridad: "BAJA" | "MEDIA" | "ALTA"

// RF-06/RF-07: roles y login propio (email + contrasena). Sin registro publico:
// las cuentas las crea el Administrador (specs.md seccion 4 / Out-of-Scope).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  rol          String   @default("USUARIO")
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  proyectosCreados   Project[]        @relation("ProyectoCreador")
  ticketsCreados     Ticket[]         @relation("TicketCreador")
  ticketsArchivados  Ticket[]         @relation("TicketArchivadoPor")
  responsableDe      TicketAssignee[]
  comentarios        Comment[]
}

// RF-04: entidad propia; Admin y Usuario crean/editan (Usuario solo los propios);
// visibilidad restringida para Usuario (RF-17).
model Project {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  creadoEn    DateTime @default(now())

  creadorId String
  creador   User   @relation("ProyectoCreador", fields: [creadorId], references: [id])

  tickets Ticket[]
}

// RF-01/RF-02/RF-03/RF-05/RF-08/RF-09/RF-10/RF-16
model Ticket {
  id            String    @id @default(cuid())
  titulo        String
  descripcion   String?
  estado        String    @default("POR_HACER")
  prioridad     String    @default("MEDIA")
  fecha         DateTime?
  archivado     Boolean   @default(false) // RF-02: "eliminar" = archivo logico
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  cerradoEn     DateTime? // se completa al pasar a TERMINADO (para RF-13)

  proyectoId String // RF-03: un ticket pertenece a un unico proyecto
  proyecto   Project @relation(fields: [proyectoId], references: [id])

  creadorId String
  creador   User   @relation("TicketCreador", fields: [creadorId], references: [id])

  archivadoPorId String? // RF-02: traza de quien archivo (solo si el Admin archiva un ticket de un tercero)
  archivadoPor   User?   @relation("TicketArchivadoPor", fields: [archivadoPorId], references: [id])

  responsables TicketAssignee[] // RF-05: cero, uno o varios responsables
  etiquetas    TicketTag[]      // RF-09b
  comentarios  Comment[]        // RF-11
}

// RF-05: relacion muchos-a-muchos ticket-responsable
model TicketAssignee {
  ticketId String
  userId   String
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@id([ticketId, userId])
}

// RF-09b: etiquetas libres, cualquier usuario puede crearlas al editar un ticket
model Tag {
  id     String @id @default(cuid())
  nombre String @unique

  tickets TicketTag[]
}

model TicketTag {
  ticketId String
  tagId    String
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([ticketId, tagId])
}

// RF-11: comentarios dentro de un ticket (autor y fecha visibles)
model Comment {
  id        String   @id @default(cuid())
  contenido String
  fecha     DateTime @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  autorId String
  autor   User   @relation(fields: [autorId], references: [id])
}
