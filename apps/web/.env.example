# Origen del backend (sin /api; api.ts lo antepone).
VITE_API_URL=http://localhost:3100
# Token de desarrollo: POST /api/auth/login a mano y pegar data.token. Solo en .env.local, nunca commitear.
VITE_API_TOKEN=
# Usuario de desarrollo (fase sin auth): se envía como creadorId/autorId/actorId en los endpoints P1.
VITE_DEV_USER_ID=user-1
